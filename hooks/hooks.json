{
  "description": "Capture a turn baseline and report token usage when the turn stops.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-token-counter\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\scripts\\token-counter\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-token-counter\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\scripts\\token-counter\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-token-counter\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\scripts\\token-counter\"",
            "timeout": 5,
            "statusMessage": "Calculating token usage"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/scripts/run-token-counter\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\scripts\\token-counter\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
